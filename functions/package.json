{
  "name": "prediction_league_functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Prediction League",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "tsc && node test/scoring.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project prediction-league-rules-test \"node test/rules.test.js\"",
    "test:all": "npm test && npm run test:rules"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^4.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20.14.0",
    "firebase": "^12.19.0",
    "firebase-functions-test": "^3.5.0",
    "typescript": "^5.5.0"
  },
  "dependenciesMeta": {},
  "private": true
}
