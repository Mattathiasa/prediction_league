rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own doc only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fixtures: any logged-in user can read and write (client-side sync).
    // Free-tier (Spark) compatible — no Cloud Functions required.
    match /fixtures/{fixtureId} {
      allow read, write: if request.auth != null;
    }

    // Predictions: users can read/write their own only
    match /predictions/{predictionId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }
  }
}
