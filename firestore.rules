rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own doc only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Fixtures: readable by all authenticated users.
    // Writable by authenticated users — relies on App Check enforcement
    // (enable in Firebase console) to prevent forged writes from
    // non-genuine clients. On Spark Plan there's no server-side admin check.
    // To fully secure, upgrade to Blaze and move writes to Cloud Functions.
    match /fixtures/{fixtureId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['status', 'homeScore', 'awayScore']);
      allow delete: if false;
    }

    // Predictions: users can read/write their own only
    match /predictions/{predictionId} {
      allow read, write: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }
  }
}
