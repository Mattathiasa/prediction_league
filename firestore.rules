rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── App Check enforcement ───────────────────────────────────────────────────
    // Enable App Check for Firestore in the Firebase console (App Check →
    // Firestore → Enforce). This requires production attestation providers.
    function isAppChecked() {
      return request.app != null;
    }

    // ── Users ───────────────────────────────────────────────────────────────────
    // Users can read/write their own doc only.
    // The `isPremium` field can only be set by a trusted source — users
    // cannot toggle their own premium status.
    match /users/{userId} {
      allow read: if isAppChecked() && request.auth.uid == userId;
      allow create: if isAppChecked() && request.auth.uid == userId;
      allow update: if isAppChecked() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoUrl']);
      allow delete: if false;
    }

    // ── Fixtures ────────────────────────────────────────────────────────────────
    // Readable by all authenticated users.
    // Writable only by Admin SDK (Cloud Functions with admin privileges).
    // The client cannot create or update fixtures — use the `syncFixtures`
    // callable Cloud Function instead.
    match /fixtures/{fixtureId} {
      allow read: if isAppChecked();
      allow create, update: if false; // Server-side only (Cloud Functions)
      allow delete: if false;
    }

    // ── Predictions ─────────────────────────────────────────────────────────────
    // Users can create predictions with homeGuess/awayGuess only.
    // Once locked (by server-side scoring), no further writes allowed.
    // The `pointsEarned` and `locked` fields are server-managed only.
    match /predictions/{predictionId} {
      // Read: owner only
      allow read: if isAppChecked()
        && request.auth.uid == resource.data.userId;

      // Create: owner only, restricted fields
      allow create: if isAppChecked()
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.keys().hasOnly([
          'predictionId', 'userId', 'fixtureId',
          'homeGuess', 'awayGuess', 'submittedAt', 'locked'
        ])
        && request.resource.data['locked'] == false
        && request.resource.data['pointsEarned'] == 0;

      // Update: owner only, and only if not yet locked
      allow update: if isAppChecked()
        && request.auth.uid == resource.data.userId
        && resource.data.locked == false
        && request.resource.data.keys().hasOnly([
          'homeGuess', 'awayGuess', 'submittedAt'
        ]);

      allow delete: if false;
    }

    // ── Leagues ────────────────────────────────────────────────────────────────
    // Members can read leagues they belong to.
    // Only the league admin can create/modify leagues.
    match /leagues/{leagueId} {
      allow read: if isAppChecked()
        && resource.data.memberIds.hasAny([request.auth.uid]);

      allow create: if isAppChecked()
        && request.auth.uid == request.resource.data.adminId
        && request.resource.data.keys().hasAll([
          'name', 'adminId', 'memberIds', 'inviteCode', 'createdAt'
        ]);

      allow update: if isAppChecked()
        && resource.data.adminId == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'memberIds', 'inviteCode'])
        && request.resource.data.memberIds.size() <= 20;

      allow delete: if isAppChecked()
        && resource.data.adminId == request.auth.uid;
    }

    // ── Admin roles ──────────────────────────────────────────────────────────────
    // Server-managed collection — only writable by Cloud Functions.
    // Used by checkAdmin callable function for PIN-free admin verification.
    match /admin_roles/{userId} {
      allow read: if isAppChecked() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    // ── Status transition validator ────────────────────────────────────────────
    function _validStatusTransition(current, next) {
      return (next == 'live' && current == 'upcoming')
        || (next == 'finished' && (current == 'upcoming' || current == 'live'));
    }
  }
}
